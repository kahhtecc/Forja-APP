<?xml version="1.0" encoding="utf-8"?>
<!-- Só HTTPS e só certificados do sistema (sem CAs instaladas pelo usuário, que permitiriam interceptar o tráfego). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
